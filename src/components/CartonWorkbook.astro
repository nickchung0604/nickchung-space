---
interface Props { locale?: string }
const { locale = "en" } = Astro.props;
const zh = locale === "zh-hant"
  ? {
      title: "2012 年紙箱報價複核｜Excel 原始數值",
      intro: "依 2012 年試算表重製，尺寸為毫米，價格為每只紙箱。四個料號依原表順序列為 A–D。",
      headers: ["尺寸（mm）", "標準價（THB）", "原單價（THB）", "初報價（THB）", "三輪議價後（THB）", "較原價", "較標準價"],
      formula: "試算表先將長、寬、高由毫米換算為公分，再套用紙價 0.4551 和表中的係數。標準價以 31.5 泰銖兌 1 美元換算。",
      finding: "前三項議價後低於模型標準價約 4.7%–5.5%，第四項卻高出 14.79%。但第四項初報 45 泰銖、議價後 39.60 泰銖，較原價 26.46 泰銖仍高 49.66%。這個差異就是為什麼要分開看初報價、議價結果和模型標準價。"
    }
  : locale === "zh-hans"
  ? {
      title: "2012 年纸箱报价复核｜Excel 原始数值",
      intro: "按 2012 年工作簿重制，尺寸为毫米，价格为每只纸箱。四个料号按原表顺序标为 A–D。",
      headers: ["尺寸（mm）", "标准价（THB）", "原单价（THB）", "初始报价（THB）", "三轮谈判后（THB）", "较原价", "较标准价"],
      formula: "工作簿先将长、宽、高由毫米换算成厘米，再代入纸价 0.4551 和表内系数。标准价按 1 美元兑 31.5 泰铢换算。",
      finding: "前三项谈判后的价格比模型标准价低约 4.7%–5.5%，第四项却高出 14.79%。第四项初报 45 泰铢、谈判后为 39.60 泰铢，但仍比原价 26.46 泰铢高 49.66%。因此单看谈判降下来的金额，无法判断最终价格是否合理。"
    }
  : {
      title: "2012 carton quotation review — figures from the workbook",
      intro: "Recreated from the 2012 Excel workbook. Dimensions are in millimeters and prices are per carton. The four original rows are shown in order as A–D.",
      headers: ["Dimensions (mm)", "Modeled price (THB)", "Previous price (THB)", "Initial quote (THB)", "After three rounds (THB)", "vs. previous", "vs. modeled"],
      formula: "The workbook converts dimensions from millimeters to centimeters before applying its paper-price input of 0.4551 and the formula coefficients. It converts the modeled USD result to THB at 31.5 THB per USD.",
      finding: "The first three negotiated prices were 4.7–5.5% below the modeled benchmark. The fourth was 14.79% above it. Its initial quote was THB 45.00, the negotiated price was THB 39.60, and the previous price was THB 26.46. That is a 49.66% increase over the previous price despite the reduction from the initial quote."
    };
const comparisonRows = [
  ["A", "3,500", "19.00", "16.00", "+18.75%", "0.4315", "13.59"],
  ["B", "4,000", "20.00", "16.00", "+25.00%", "0.4516", "14.23"],
  ["C", "4,000", "22.00", "—", "—", "0.4717", "14.86"],
  ["D", "2,500", "36.00", "—", "—", "—", "—"],
];
const comparison = locale === "zh-hant"
  ? ["交叉報價與數量", "料號代碼", "數量（只）", "供應商 B 新報價（THB）", "供應商 B 原報價（THB）", "供應商 B 調幅", "供應商 C（USD）", "供應商 C（THB）", "四項產品合計 14,000 只。工作表將其他來源的報價一併比較，並建議就高用量料號取得兩家供應商的報價。破折號表示原表沒有可比數值。"]
  : locale === "zh-hans"
  ? ["交叉报价与数量", "料号代号", "数量（只）", "供应商 B 新报价（THB）", "供应商 B 原报价（THB）", "供应商 B 涨幅", "供应商 C（USD）", "供应商 C（THB）", "四款产品合计 14,000 只。工作簿一并比较了其他来源的报价，并建议就用量较高的料号取得两家供应商的报价。破折号表示原表没有可比数据。"]
  : ["Cross-supplier quotes and volumes", "Item code", "Volume (units)", "Supplier B new (THB)", "Supplier B previous (THB)", "Supplier B change", "Supplier C (USD)", "Supplier C (THB)", "The four items totaled 14,000 units. The workbook compared other quotes and recommended obtaining two quotes for the higher-volume items. A dash indicates no comparable value in the original sheet."];
const parameterRows = locale === "zh-hant" ? [
  ["0.4551", "原表 Paper U/P，單位為美元／千平方英吋紙板，約合每平方公尺 0.7054 美元。四列使用同一數值。原表未記錄牌號、報價日期或原始報價單。"],
  ["÷ 10,000 × 1.55", "先把平方公分轉為平方公尺，再轉為千平方英吋。1 平方英吋恰為 6.4516 平方公分，因此 1 平方公尺約為 1.550003 千平方英吋。"],
  ["+5、+3、×2", "原表保存的紙箱展開估算式。×2 對應長、寬兩組箱面。+5 與 +3 為這個算式的尺寸加量，原表未細分各自的接合、摺線或修邊留量。"],
  ["31.5", "原表的幣別換算假設，每美元 31.5 泰銖。"]
] : locale === "zh-hans" ? [
  ["0.4551", "原表 Paper U/P，单位为美元／千平方英寸纸板，约合每平方米 0.7054 美元。四行使用同一数值。原表没有记录纸板牌号、报价日期或原始报价单。"],
  ["÷ 10,000 × 1.55", "先把平方厘米换算为平方米，再换算成千平方英寸。1 平方英寸恰为 6.4516 平方厘米，所以 1 平方米约等于 1.550003 千平方英寸。"],
  ["+5、+3、×2", "原表采用的纸箱展开估算式。×2 对应长、宽两组箱面。+5 和 +3 是这个算式的尺寸加量，原表没有细分接合、压线或修边余量。"],
  ["31.5", "原表的汇率假设，1 美元兑 31.5 泰铢。"]
] : [
  ["0.4551", "The workbook’s paperboard input price, in USD per thousand square inches, equivalent to about USD 0.7054/m². All four rows use the same input. The workbook gives no board grade, quote date or original price quotation."],
  ["÷ 10,000 × 1.55", "Convert cm² to m², then m² to thousands of square inches. One square inch is exactly 6.4516 cm², so one square meter is approximately 1.550003 thousand square inches."],
  ["+5, +3, ×2", "The carton blank estimating formula recorded in the workbook. The factor of two reflects the repeated length and width panels. The added dimensions are allowances used by this formula, with no detailed breakdown of joints, scoring or trim in the workbook."],
  ["31.5", "The workbook’s exchange-rate assumption of 31.5 THB per USD."]
];
const rows = [
  ["A · 498 × 298 × 220", "20.60", "15.98", "25.00", "19.47", "+21.84%", "−5.50%"],
  ["B · 498 × 298 × 244", "21.51", "16.31", "24.00", "20.35", "+24.79%", "−5.37%"],
  ["C · 498 × 298 × 286", "23.08", "15.88", "25.50", "22.00", "+38.54%", "−4.70%"],
  ["D · 600 × 500 × 145", "34.50", "26.46", "45.00", "39.60", "+49.66%", "+14.79%"],
];
---
<section class="carton-workbook">
  <h2>{zh.title}</h2>
  <p>{zh.intro}</p>
  <figure class="case-visual">
    <div class="case-visual-scroll" tabindex="0" role="region" aria-label={zh.title}>
      <table>
        <thead><tr>{zh.headers.map(header => <th scope="col">{header}</th>)}</tr></thead>
        <tbody>{rows.map(row => <tr><th scope="row">{row[0]}</th>{row.slice(1).map(value => <td>{value}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </figure>
  <p>{zh.formula}</p>
  <pre><code>(L/10 + W/10 + 5) × (W/10 + H/10 + 3)
× 2 × 0.4551 × 1.55 ÷ 10,000
A = USD 0.65406 × 31.5 = THB 20.60</code></pre>
  <h3>{locale === "en" ? "What the inputs mean" : locale === "zh-hant" ? "公式參數從哪裡來" : "公式参数从哪里来"}</h3>
  <dl class="case-details">
    {parameterRows.map(([input, detail]) => <div><dt>{input}</dt><dd>{detail}</dd></div>)}
  </dl>
  <p><a href="https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b9">NIST SP 811</a> · <a href="https://www.fefco.org/download/file/fid/1238">FEFCO 0201</a></p>
  <p>{zh.finding}</p>
  <figure class="case-visual">
    <div class="case-visual-scroll" tabindex="0" role="region" aria-label={comparison[0]}>
      <table>
        <caption>{comparison[0]}</caption>
        <thead><tr>{comparison.slice(1, 8).map(label => <th scope="col">{label}</th>)}</tr></thead>
        <tbody>{comparisonRows.map(row => <tr><th scope="row">{row[0]}</th>{row.slice(1).map(value => <td>{value}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <figcaption>{comparison[8]}</figcaption>
  </figure>
</section>
