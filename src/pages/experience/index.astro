---
import Layout from "../../layouts/Layout.astro";
import { workCopy } from "../../data/work";
import { capabilities } from "../../data/work-details";
import { capabilityDescriptions } from "../../data/work-visuals";
---
<Layout title={workCopy.title}>
  <div class="portfolio-light">
    <div class="container">
      <h1>{workCopy.title}</h1>
      <p>Explore my work by capability.</p>
      <div class="capability-grid">
        {capabilities.map(area => <a class="capability-card" href={`/experience/area/${area.id}/`}>
          <h2>{area.title}</h2>
          <p>{capabilityDescriptions[area.id]}</p>
          <span>{area.slugs.length} case studies</span>
        </a>)}
      </div>
    </div>
  </div>
</Layout>
