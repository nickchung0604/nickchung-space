---
import { traditionalSkills, simplifiedSkills } from "../../data/zh-skills";
import CartonWorkbook from "../../components/CartonWorkbook.astro";
import VenusEvidence from "../../components/VenusEvidence.astro";
import { venusEvidence, venusEvidenceIds } from "../../data/venus-evidence";
import FeaturedEvidence from "../../components/FeaturedEvidence.astro";
import { featuredDocumentRoutes, featuredEvidence, featuredLabels } from "../../data/featured-evidence";
import { careerLinks } from "../../data/career-links";
import { timeline, awards, education } from "../../data/site";
import "../../styles/about.css";
import { localizedCareer } from "../../data/localized-career";
import Layout from "../../layouts/Layout.astro";
import { work, featuredWork } from "../../data/work";
import { capabilities, legacyCapabilities } from "../../data/work-details";
import { simplified } from "../../data/zh-content";
import { traditional } from "../../data/zh-hant-content";
import { site } from "../../data/site";

export function getStaticPaths() {
  const pages = ["", "about", "contact", "experience", ...[...capabilities, ...legacyCapabilities].map(area => "experience/area/" + area.id), ...work.map(item => "experience/" + item.slug), ...venusEvidenceIds.map(id => "experience/venus-product-definition/documents/" + id), ...featuredDocumentRoutes.map(({slug,id}) => "experience/" + slug + "/documents/" + id)];
  return ["zh-hans", "zh-hant"].flatMap(locale => pages.map(page => ({ params: { locale, page: page || undefined } })));
}
const { locale, page = "" } = Astro.params;
const isTraditional = locale === "zh-hant";
const copy = isTraditional ? {
  title:"直接物料採購與供應鏈主管", intro:"我專注於亞洲跨區域供應商管理、材料降本與營運轉型。在戴爾管理逾 2.2 億美元的年度直接物料採購額，在 Footprint Asia 帶領採購、專案與品質共 8 人的團隊，也將這些經驗運用到 AI 硬體產品定義。",
  work:"精選案例", about:"關於我", contact:"聯絡方式", cv:"下載英文履歷", profile:"職涯概覽",
  areas:["供應鏈與採購","管理與領導","AI 與科技"],
  browse:"依專業領域瀏覽案例", count:"篇案例", back:"返回精選案例",
  context:"業務背景", decisions:"我的角色與判斷", outcome:"成果", visual:"工作方法圖解",
  roles:["供應鏈暨專案管理總監","全球採購經理","Venus 產品負責人","供應鏈經理","供應鏈經理","全球採購經理","資深採購經理","專案總監／顧問","創辦人","採購總監","市場總監／獨立顧問"],
} : {
  title:"直接物料采购与供应链负责人", intro:"我专注于亚洲跨区域供应商管理、直接物料降本和运营转型。在戴尔管理超过 2.2 亿美元的年度直接物料采购额，在 Footprint Asia 带领采购、项目和质量共 8 人的团队，也把这些经验用于 AI 硬件产品定义。",
  work:"精选案例", about:"关于我", contact:"联系方式", cv:"下载英文简历", profile:"职业经历",
  areas:["供应链与采购","管理与领导","AI 与技术"],
  browse:"按专业领域浏览案例", count:"篇案例", back:"返回精选案例",
  context:"业务背景", decisions:"我的职责和关键判断", outcome:"成果", visual:"关键做法图解",
  roles:["供应链与项目管理总监","全球采购经理","Venus 产品负责人","供应链经理","供应链经理","全球采购经理","高级采购经理","项目总监／顾问","创始人","采购总监","市场总监／独立顾问"],
};
const aboutAwards = (isTraditional
  ? ["大中華區總裁團隊獎","即時表揚獎（開發金屬件成本分析課程）","MSI 包裝銅獎","Winning Together（SBA）","上海創業競賽第一名"]
  : ["大中华区总裁团队奖","即时表彰奖（开发金属件成本分析课程）","MSI 包装铜奖","Winning Together（SBA）","上海创业比赛第一名"]);
const aboutEducation = (isTraditional
  ? [["MBA 在讀","上海交通大學｜高級金融"],["國際貿易與金融學士","臺灣輔仁大學"],["商業智慧課程證書（AI 與類神經網路）","臺灣輔仁大學"]]
  : [["MBA 在读","上海交通大学｜高级金融"],["国际贸易与金融学士","台湾辅仁大学"],["商业智能课程证书（AI 与神经网络）","台湾辅仁大学"]]);
const aboutCertifications = isTraditional
  ? ["專案管理專業人士（PMP，2010 年核發）","供應管理專業認證（CPSM）","輔仁大學商業智慧課程證書"]
  : ["项目管理专业人士（PMP，2010 年获证）","供应管理专业认证（CPSM）","辅仁大学商业智能课程证书"];
const entries = isTraditional ? traditional : simplified;
const route = (suffix = "") => "/" + locale + "/" + (suffix ? suffix + "/" : "");
const areaPath = (id: string) => "experience/area/" + id;
const casePath = (slug: string) => "experience/" + slug;
const legacyArea = legacyCapabilities.find(area => areaPath(area.id) === page);
const areaIndex = capabilities.findIndex(area => areaPath(area.id) === page || area.id === legacyArea?.target);
const itemIndex = work.findIndex(item => casePath(item.slug) === page);
const item = work[itemIndex];
const current = item && entries[item.slug];
const area = capabilities[areaIndex];
const cards = area ? area.slugs.map(slug => work.find(item => item.slug === slug)!) : featuredWork;
const doc = venusEvidenceIds.find(id => page === "experience/venus-product-definition/documents/" + id);
const featuredDoc = featuredDocumentRoutes.find(({slug,id}) => page === "experience/" + slug + "/documents/" + id);
const title = (featuredDoc ? featuredEvidence[featuredDoc.slug][featuredDoc.id][isTraditional ? 1 : 2] : undefined) ?? (doc ? venusEvidence[doc][isTraditional ? 2 : 3] : undefined) ?? current?.[0] ?? (area ? copy.areas[areaIndex] : page === "contact" ? copy.contact : page === "about" ? copy.about : page === "experience" ? copy.work : copy.title);
---
<Layout title={title} description={current?.[2] ?? copy.intro} locale={locale} pagePath={page}>
  {page === "" && <section class="portfolio-hero"><div class="container portfolio-hero-inner">
    <div><h1>{isTraditional ? "鐘煒凱" : "钟炜凯"}</h1><p class="portfolio-title">{copy.title}</p><p>{copy.intro}</p>
      <div class="portfolio-actions"><a href={route("experience")}>{copy.work}</a><a href="/nick-chung-cv.pdf" download>{copy.cv}</a><a href={route("contact")}>{copy.contact}</a></div>
    </div><img src={site.profileImage} width="220" height="220" alt="Nick Chung" />
  </div></section>}
    {page === "about" && <>
    <section class="section"><div class="container">
      <h1 class="page-title">{copy.about}</h1>
      <p class="page-subtitle">{isTraditional ? "我的職涯橫跨策略採購、供應鏈營運與跨部門專案。" : "我的职业经历涵盖战略采购、供应链运营和跨部门项目。"}</p>
      <div class="intro-block">
        <p>{isTraditional ? "我在戴爾、台達、伊萊克斯及 SK 集團與麥肯錫的合作專案中，負責採購、供應商開發和供應鏈營運。管理過逾 2.2 億美元的年度採購金額，也在中國大陸、臺灣、泰國和韓國帶領或協調團隊。" : "我在戴尔、台达、伊莱克斯以及 SK 集团与麦肯锡的合作项目中，负责采购、供应商开发和供应链运营。管理过超过 2.2 亿美元的年度采购金额，也在中国大陆、台湾、泰国和韩国带领或协调团队。"}</p>
        <p>{isTraditional ? "近年，我把這些經驗用到 AI 產品與專案：協調香港公共服務的 AI 合作，創辦混合實境產品公司，並負責 Venus 高擬真陪伴機器人的產品定義。" : "近年，我把这些经验用到 AI 产品和项目中：协调香港公共服务的 AI 合作，创办混合现实产品公司，并负责 Venus 高拟真陪伴机器人的产品定义。"}</p>
        <p>{copy.intro}</p>
      </div>
    </div></section>
    <section class="section"><div class="container">
      <p class="section-title">{isTraditional ? "任職時間線" : "任职时间线"}</p>
      <div class="timeline">
        {timeline.map((item,index) => {
          const [roleHant,roleHans,,,slugs] = careerLinks[index];
          const [companyHant,companyHans,descHant,descHans] = localizedCareer[index];
          return <div class="timeline-item">
            <div class="timeline-marker"></div><div class="timeline-content">
              <span class="timeline-period">{item.period}</span>
              <h3 class="timeline-role">{isTraditional ? roleHant : roleHans}</h3>
              <p class="timeline-company">{isTraditional ? companyHant : companyHans}</p>
              <p class="timeline-desc">{isTraditional ? descHant : descHans}</p>
              {slugs.length > 0 && <ul class="career-case-links">{slugs.map(slug => <li><a href={route(casePath(slug))}>{entries[slug][0]}</a></li>)}</ul>}
            </div>
          </div>;
        })}
      </div>
    </div></section>
    <section class="section"><div class="container">
      <p class="section-title">{isTraditional ? "專業能力" : "专业能力"}</p>
      <div class="skills-grid">
        {(isTraditional ? traditionalSkills : simplifiedSkills).map((items,index) => <div>
          <h3 class="skill-category">{copy.areas[index]}</h3>
          <ul class="skill-list">{items.map(item => <li>{item}</li>)}</ul>
        </div>)}
      </div>
    </div></section>
    <section class="section"><div class="container">
      <p class="section-title">{isTraditional ? "獎項與肯定" : "奖项与表彰"}</p>
      <ul class="career-case-links">{awards.map((award,index) => <li>{award.year} · {award.org} · {aboutAwards[index]}</li>)}</ul>
    </div></section>
    <section class="section"><div class="container">
      <p class="section-title">{isTraditional ? "學歷" : "教育背景"}</p>
      <ul class="career-case-links">{education.map((item,index) => <li>{item.period.replace("Present","至今")} · {aboutEducation[index][1]} · {aboutEducation[index][0]}</li>)}</ul>
    </div></section>
    <section class="section"><div class="container">
      <p class="section-title">{isTraditional ? "專業證照" : "专业证书"}</p>
      <ul class="career-case-links">{aboutCertifications.map(item => <li>{item}</li>)}</ul>
    </div></section>
  </>}
  {page === "about" ? null : doc ? <VenusEvidence locale={locale} document={doc} /> : featuredDoc ? <FeaturedEvidence slug={featuredDoc.slug} document={featuredDoc.id} locale={locale} /> : <div class="portfolio-light"><div class:list={["container", {"case-content": Boolean(current)}]}>
    {(area || current) && <a href={route("experience")}>{copy.back}</a>}
    {page && <h1>{title}</h1>}
    {page === "experience" && <>
      <nav class="work-jump">{capabilities.map((area,index) => <a href={`#${area.id}`}>{copy.areas[index]}</a>)}</nav>
      {capabilities.map((area,index) => <section class="work-category" id={area.id}>
        <h2>{copy.areas[index]}</h2>
        <ul class="case-index-list">{area.slugs.map(slug => {
          const item = work.find(entry => entry.slug === slug)!;
          return <li><a href={route(casePath(slug))}>{entries[slug][0]}</a><span>{item.company} · {item.period}</span></li>;
        })}</ul>
        <a href={route(areaPath(area.id))}>{isTraditional ? "查看能力細項" : "查看能力细项"}</a>
      </section>)}
    </>}
    {area && <section><h2>{isTraditional ? "能力細項" : "能力细项"}</h2><ul class="capability-skills">{(isTraditional ? traditionalSkills : simplifiedSkills)[areaIndex].map(skill => <li>{skill}</li>)}</ul></section>}
    {(area || !page) && <><h2>{copy.work}</h2><div class:list={["work-grid", { "area-cases": Boolean(area) }]}>
      {cards.map(item => <article class="work-card">{!page && <p class="featured-label">{featuredLabels[item.slug][isTraditional ? 1 : 2]}</p>}<p class="work-meta">{item.company} · {item.period}</p>
        <h2><a href={route(casePath(item.slug))}>{entries[item.slug][0]}</a></h2><strong>{entries[item.slug][1]}</strong><p>{entries[item.slug][2]}</p></article>)}
    </div></>}
    {current && <><p class="work-meta">{item.company} · {item.period} · {copy.roles[itemIndex]}</p><p class="case-result">{current[1]}</p><p>{current[2]}</p>
      <section><h2>{copy.context}</h2><p>{current[3]}</p></section>
      <section><h2>{copy.decisions}</h2><p>{current[4]}</p></section>
      {item.slug === "delta-carton-cost-analysis" ? <CartonWorkbook locale={locale} /> : <section><h2>{copy.visual}</h2><dl class="case-details">{current[6].map(row => {
        const [heading, ...detail] = row.split("｜");
        return <div><dt>{heading}</dt><dd>{detail.join(" · ")}</dd></div>;
      })}</dl></section>}
      {item.slug === "venus-product-definition" && <VenusEvidence locale={locale} />}
      <FeaturedEvidence slug={item.slug} locale={locale} />
      <section><h2>{copy.outcome}</h2><p>{current[5]}</p></section>
      {item.evidence.length > 0 && <section><h2>{isTraditional ? "工作示意圖" : "工作示意图"}</h2>
        {item.evidence.map(sample => <figure class="case-visual">
          <a href={sample.image} target="_blank" rel="noopener">
            <img src={sample.image} alt={isTraditional ? "開啟案例示意圖" : "打开案例示意图"} loading="lazy" style="display:block;width:100%;height:auto;" />
          </a>
        </figure>)}
      </section>}
      <nav class="work-jump">{capabilities.map((area,index) => area.slugs.includes(item.slug) && <a href={route(areaPath(area.id))}>{copy.areas[index]}</a>)}</nav>
    </>}
    {page === "contact" && <><p><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.linkedin}>LinkedIn</a> · <a href="/nick-chung-cv.pdf" download>{copy.cv}（PDF）</a></p><p>{isTraditional ? "常駐上海，可考慮上海、香港與深圳的工作機會。" : "常驻上海，可考虑上海、香港和深圳的工作机会。"}</p></>}
  </div></div>}
</Layout>
