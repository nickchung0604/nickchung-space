---
import Layout from "../layouts/Layout.astro";
import { featuredLabels } from "../data/featured-evidence";
import WorkCard from "../components/WorkCard.astro";
import { site } from "../data/site";
import { featuredWork, workCopy } from "../data/work";
---
<Layout>
  <section class="portfolio-hero">
    <div class="container portfolio-hero-inner">
      <div>
        <h1>{site.name}</h1>
        <p class="portfolio-title">{site.title}</p>
        <p>{site.tagline}</p>
        <div class="portfolio-actions">
          <a href="/experience/">{workCopy.view}</a>
          <a href="/nick-chung-cv.pdf" download>Download CV</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
      <img src={site.profileImage} width="220" height="220" alt={site.name} />
    </div>
  </section>
  <section class="portfolio-light">
    <div class="container">
      <h2>{workCopy.title}</h2>
      <div class="work-grid">{featuredWork.map(item => <WorkCard item={item} label={featuredLabels[item.slug][0]} />)}</div>
    </div>
  </section>
</Layout>
