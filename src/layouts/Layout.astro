---
import "../styles/global.css";
import { site, nav } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  pagePath?: string;
}

const { title, description, locale = "en", pagePath = Astro.url.pathname.replace(/^\/|\/$/g, "") } = Astro.props;
const language = locale === "zh-hant" ? "zh-Hant" : locale === "zh-hans" ? "zh-Hans" : "en";
const languages = [
  { id: "en", label: "English" },
  { id: "zh-hant", label: "繁體中文" },
  { id: "zh-hans", label: "简体中文" },
];
const localHref = (id: string, page = "") => "/" + [id === "en" ? "" : id, page].filter(Boolean).join("/") + ((id !== "en" || page) ? "/" : "");
const links = locale === "en" ? nav : [
  { label: locale === "zh-hant" ? "關於我" : "关于我", href: localHref(locale, "about") },
  { label: locale === "zh-hant" ? "精選案例" : "精选案例", href: localHref(locale, "experience") },
  { label: locale === "zh-hant" ? "聯絡方式" : "联系方式", href: localHref(locale, "contact") },
];
const displayName = locale === "zh-hant" ? "鐘煒凱" : locale === "zh-hans" ? "钟炜凯" : site.name;
const pageTitle = title ? `${title} · ${displayName}` : `${displayName} — ${site.title}`;
const pageDescription = description || site.tagline;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={site.profileImage} />
    <title>{pageTitle}</title>
    {languages.map(item => <link rel="alternate" hreflang={item.id === "zh-hant" ? "zh-Hant" : item.id === "zh-hans" ? "zh-Hans" : "en"} href={new URL(localHref(item.id, pagePath), Astro.site ?? Astro.url).href} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={localHref(locale)} class="logo">{displayName}</a>
        <nav class="nav">
          {links.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <nav class="locale-links" aria-label={locale === "en" ? "Languages" : locale === "zh-hant" ? "語言" : "语言"}>
          {languages.map(item => <a href={localHref(item.id, pagePath)} lang={item.id === "zh-hant" ? "zh-Hant" : item.id === "zh-hans" ? "zh-Hans" : "en"} aria-current={item.id === locale ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {displayName}. All rights reserved.</p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: rgba(15, 17, 21, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
      }

      .locale-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; font-size: .875rem; }
      .locale-links [aria-current] { color: #a6d0ff; text-decoration: underline; }
      .header-inner {
        gap: .8rem;
        flex-wrap: wrap;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
      }

      .logo {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-text);
      }

      .logo:hover {
        color: var(--color-accent);
      }

      .nav {
        display: flex;
        gap: 28px;
      }

      .nav a {
        font-size: 14px;
        font-weight: 500;
        color: var(--color-text-secondary);
      }

      .nav a:hover {
        color: var(--color-text);
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 32px 0;
        margin-top: 64px;
      }

      .site-footer p {
        font-size: 13px;
        color: var(--color-text-muted);
        text-align: center;
      }

      @media (max-width: 720px) {
        .site-header { position: static; }
        .header-inner { justify-content: center; gap: 0 .85rem; padding: .45rem .75rem; }
        .nav { flex-wrap: wrap; justify-content: center; gap: 0 .65rem; }
        .locale-links { flex: 1 0 100%; gap: 0 .85rem; }
        .nav a, .locale-links a { display: inline-flex; align-items: center; min-height: 44px; }
      }
    </style>
  </body>
</html>
